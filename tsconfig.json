{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es6",
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "incremental": true,
    "jsx": "preserve",
    "sourceMap": true,
    "outDir": "dist",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@controllers/*": ["src/controllers/*"],
      "@interfaces/*": ["src/interfaces/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@prism/*": ["prisma/*"],
      "@repository/*": ["src/repository/*"],
      "@routes/*": ["src/routes/*"],
      "@schemas/*": ["src/schemas/*"],
      "@server/*": ["src/server/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": [
    "build",
    "coverage",
    "logs",
    "node_modules",
    "__test__"
  ]
}
